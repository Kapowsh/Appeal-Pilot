NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
MODEL_FAST=        # e.g. nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B (extraction)
MODEL_REASON=      # e.g. nvidia/nemotron-3-super-120b-a12b (matching, drafting, review)
MODEL_EMBED=       # embeddings model from /v1/models; empty -> BM25 fallback
TAVILY_API_KEY=    # optional
ENABLE_TAVILY=false
MAX_RUNS_PER_IP_PER_HOUR=10
TRUST_PROXY=false  # true only behind a reverse proxy that appends X-Forwarded-For
